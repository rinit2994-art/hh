# Market Data Fetcher Configuration
# ==================================
# Copy this file to .env and add your actual API keys

# API Keys
# --------

# Finnhub API Key
# Get your free API key at: https://finnhub.io/
# Free tier: 60 API calls per minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# Financial Modeling Prep API Key
# Get your free API key at: https://financialmodelingprep.com/developer/docs/
# Free tier: 250 API calls per day
FMP_API_KEY=your_fmp_api_key_here


# Data Fetcher Settings
# ---------------------

# Preferred data source: "yfinance", "finnhub", or "fmp"
# The fetcher will try this source first, then fallback to others
PREFERRED_SOURCE=yfinance

# Cache timeout in seconds (default: 300 = 5 minutes)
# Cached data will be reused within this timeframe
CACHE_TIMEOUT=300

# Maximum number of retry attempts for failed requests
MAX_RETRIES=4

# Initial retry delay in seconds (doubles with each retry)
RETRY_DELAY=2.0


# Rate Limiting
# -------------
# Calls per minute for each data source

# yfinance rate limit (unofficial, be conservative)
YFINANCE_RATE_LIMIT=60

# Finnhub rate limit (free tier: 60 calls/min)
FINNHUB_RATE_LIMIT=60

# FMP rate limit (free tier: 250 calls/day, ~4 calls/min)
# Note: This is daily limit, but we rate limit per minute
FMP_RATE_LIMIT=250
